# Phase 2: discovery public config and server setup scripts. See docs/PHASE_2_SETUP.md.
# Existing .env files are preserved; later-phase entries remain unused.
# All credential values intentionally blank. Never commit a populated .env.
# Only VITE_ variables are intentionally public browser configuration.

# Public application configuration (Phase 1)
VITE_APP_NAME="Smart Travel Plan and Discovery App"
# auto | demo | live; live must report missing capabilities explicitly.
VITE_APP_MODE=auto
# Local default; set the real origin during approved hosting setup.
VITE_APP_URL=http://localhost:5173

# Public Supabase client configuration (Phase 2 proxies / Phase 10 accounts)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Confidential provider configuration: server functions only
# Phase 6: verify current pricing, eligibility, model lifecycle, and project quota.
# Approved stable planner/chat models, amended 6 November 2026; no automatic switching.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# Phase 2: shared places/search/routing allowance
GEOAPIFY_API_KEY=
# Phase 2 optional: new Pexels key issuance is paused as of research date.
PEXELS_API_KEY=

# Phase 2 hosted setup automation; local administration only, never function secrets
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Final Phase 10 OAuth option; provider choice is not yet approved; registration is an unavoidable account action.
# Requires approval of this auth choice before configuration; setup only.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Function configuration (Phase 2 onward). Comma-separated exact origins.
# CORS is a browser restriction, not authorization or abuse prevention.
FUNCTION_ALLOWED_ORIGINS=http://localhost:5173
# Server-only quota ceilings: proposed application budgets, not provider entitlements.
GEOAPIFY_DAILY_CREDIT_BUDGET=100
PEXELS_HOURLY_REQUEST_BUDGET=100
PEXELS_MONTHLY_REQUEST_BUDGET=10000
# Phase 6: approved ceiling; does not itself enable AI or authorize live requests.
AI_DAILY_REQUEST_BUDGET=5
AI_REQUESTS_PER_USER_PER_DAY=3
# Future separately approved hosted AI function only; local dev injects an ephemeral capability automatically.
AI_DEVELOPMENT_TOKEN=
# Optional non-secret AI deadline; defaults need no .env edit. Integer 1000–100000 ms.
# Handler/browser deadlines derive as +5000/+10000 ms. Restart dev after changes.
AI_PROVIDER_TIMEOUT_MS=75000

# Phase 8: default off until intended use is verified under Open-Meteo terms.
VITE_WEATHER_ENABLED=false

# Phase 10 only: optional deployment administration; no deploy script exists yet.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT_NAME=smart-travel
