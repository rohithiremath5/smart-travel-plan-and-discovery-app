{
  "name": "smart-travel-plan-and-discovery-app",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "minimatch": "11.0.4"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23 || >=24.0.0 <25"
  },
  "scripts": {
    "setup:env": "tsx scripts/setup-env.ts",
    "setup:check": "tsx scripts/setup-check.ts",
    "predev": "npm run setup:check",
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test",
    "build": "npm run typecheck && vite build && tsx scripts/check-bundle.ts",
    "review:zip": "tsx scripts/review-zip.ts",
    "setup:backend": "tsx scripts/setup-backend.ts",
    "setup:mapping": "tsx scripts/setup-mapping.ts",
    "setup:ai": "tsx scripts/setup-ai.ts",
    "verify:ai": "tsx scripts/verify-ai.ts",
    "verify:planner": "tsx scripts/verify-planner.ts",
    "verify:planner:timeout": "tsx scripts/verify-timeout-planner.ts",
    "setup:secrets": "tsx scripts/setup-secrets.ts",
    "verify:live": "tsx scripts/verify-live.ts",
    "build:e2e": "vite build --mode e2e --outDir .cache/e2e-dist"
  },
  "dependencies": {
    "@google/genai": "3.0.0",
    "@hookform/resolvers": "7.0.2",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@tanstack/react-query": "5.105.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.68.0",
    "maplibre-gl": "6.16.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.91.0",
    "react-router": "7.18.5",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@electric-sql/pglite": "0.5.15",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "fake-indexeddb": "6.2.7",
    "fflate": "0.8.3",
    "globals": "17.14.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.10",
    "supabase": "3.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
